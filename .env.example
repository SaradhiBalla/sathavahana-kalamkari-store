# Copy to .env for local Compose use. Replace every value before deploying.
POSTGRES_DB=kalamkari
POSTGRES_USER=kalamkari
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=jdbc:postgresql://postgres:5432/kalamkari
DATABASE_USERNAME=kalamkari
DATABASE_PASSWORD=replace-with-a-long-random-password
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_API_URL=http://localhost:8080/api/v1
